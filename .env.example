# Copie este arquivo para ".env" para sobrescrever os valores padrão localmente.
# Nenhuma dessas variáveis é obrigatória, o app funciona normalmente sem elas.

# URLs das APIs públicas de consulta de CNPJ
BRASILAPI_URL=https://brasilapi.com.br/api/cnpj/v1/{cnpj}
CNPJ_WS_URL=https://publica.cnpj.ws/cnpj/{cnpj}

# Timeout e tentativas de cada requisição
TIMEOUT_REQUISICAO=10.0
TENTATIVAS=5

# Concorrência e limite de requisições (proteção contra HTTP 429)
MAX_WORKERS=5
INTERVALO_MINIMO=0.25
INTERVALO_FALLBACK=21.0
